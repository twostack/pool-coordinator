    "eslint": "^9.39.5",
    "happy-dom": "^20.14.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^6.4.3",
    "vitest": "^4.1.11",
    "yaml": "^2.9.1"
  }
