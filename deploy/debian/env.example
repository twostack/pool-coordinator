# pool-coordinator secrets.
#
# Installed at /etc/pool-coordinator/env, owned root:pool-coordinator, mode
# 640. run.sh exports these to the coordinator's environment; they never
# appear on its command line or in its logs. `apt purge` deletes this file.

# The passphrase the wallet file is encrypted under (required). `create`
# encrypts the new wallet under it, so set it before creating the pool.
POOL_WALLET_PASSPHRASE=

# The node's RPC password, for chain.kind: node (not needed for testnet).
POOL_RPC_PASSWORD=
