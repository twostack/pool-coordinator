<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The hardened runtime's one exception for pool-coordinator. The Dart AOT
  runtime maps its compiled snapshot into executable memory without MAP_JIT,
  so allow-jit alone is not enough (measured: killed at start); nothing else
  is relaxed, and library validation stays on, so only libraries signed by
  the same team load.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
</dict>
</plist>
